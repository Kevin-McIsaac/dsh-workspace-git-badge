{
  "name": "dsh-git-badge",
  "version": "0.20.0",
  "description": "Git status badges for DeepSeek Harness: an input-row chip and a sidebar session-row action glyph, on every install — no patch and no manual step. Event-driven freshness over SSE.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-git-badge": "seam/cli.js",
    "dsh-git-badge-checkout": "seam/checkout.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "git",
    "status",
    "badge",
    "sidebar"
  ],
  "author": "Kevin McIsaac",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin-McIsaac/dsh-workspace-git-badge.git",
    "directory": "dsh-git-badge"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/index.js",
    "package.json",
    "seam/checkout.js",
    "seam/cli.js",
    "seam/skill.js",
    "seam/store.js",
    "skill/gh/SKILL.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
