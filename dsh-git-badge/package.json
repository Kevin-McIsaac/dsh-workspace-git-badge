{
  "name": "dsh-git-badge",
  "version": "0.9.1",
  "description": "Git status badges for DeepSeek Harness: sidebar session rows (via the sidebar.workspaces.sessionRow seam) and an input-row chip showing the current conversation's workspace git state. Event-driven freshness over SSE.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-git-badge-seam": "seam/apply.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "git",
    "status",
    "badge",
    "sidebar"
  ],
  "author": "Kevin McIsaac",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin-McIsaac/dsh-workspace-git-badge.git",
    "directory": "dsh-git-badge"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "seam/apply.js",
    "seam/anchors.js",
    "seam/stub-index.js",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
